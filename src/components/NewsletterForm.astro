---
import { NEWSLETTER_ENDPOINT, HONEYPOT_FIELD, CONSENT_LABEL, MIN_FILL_MS } from "../newsletter";

interface Props {
  endpoint?: string;
  headline?: string;
  /** eindeutige Kennung, wenn mehrere Formulare auf einer Seite stehen */
  formId?: string;
}
const {
  endpoint = NEWSLETTER_ENDPOINT,
  headline = "Neue Werke, Ausstellungen, Texte — gelegentlich per Mail.",
  formId = "newsletter",
} = Astro.props;
---

<div class="max-w-md mx-auto mt-10 mb-2">
  <div class="text-center mb-5">
    <div class="text-[0.7rem] tracking-[0.3em] uppercase text-[var(--color-accent)] mb-3">
      Newsletter
    </div>
    <p class="text-sm text-[var(--color-muted-foreground)] leading-relaxed">
      {headline}
    </p>
  </div>

  <form
    action={endpoint}
    method="post"
    class="flex flex-col gap-3"
    data-newsletter-form
    data-min-fill={MIN_FILL_MS}
  >
    <div class="flex flex-col sm:flex-row gap-2">
    <label class="sr-only" for={`${formId}-email`}>E-Mail-Adresse</label>
    <input
      id={`${formId}-email`}
      type="email"
      name="email"
      required
      autocomplete="email"
      placeholder="E-Mail-Adresse"
      class="flex-1 px-4 py-2.5 bg-[var(--color-card)] border border-[var(--color-border)] rounded-sm text-sm text-[var(--color-foreground)] placeholder:text-[var(--color-muted-foreground)]/50 focus:outline-none focus:border-[var(--color-accent)] focus:ring-1 focus:ring-[var(--color-accent)]/50 transition-colors"
    />
    {/* Honigtopf — von Menschen unsichtbar, muss leer bleiben */}
    <div class="absolute left-[-5000px]" aria-hidden="true">
      <input
        type="text"
        name={HONEYPOT_FIELD}
        tabindex="-1"
        autocomplete="off"
      />
    </div>
      <button
        type="submit"
        class="px-5 py-2.5 rounded-sm bg-[var(--color-accent)] text-[var(--color-accent-foreground)] text-xs tracking-[0.2em] uppercase font-medium glow-amber-sm hover:glow-amber transition-shadow whitespace-nowrap"
      >
        Abonnieren
      </button>
    </div>

    <label class="flex items-start gap-2.5 text-[0.7rem] text-[var(--color-muted-foreground)] leading-relaxed cursor-pointer">
      <input
        type="checkbox"
        name="zustimmung"
        value="ja"
        required
        class="mt-0.5 shrink-0 accent-[var(--color-accent)]"
      />
      <span>{CONSENT_LABEL}</span>
    </label>
    <div data-turnstile></div>
  </form>

  <p
    data-newsletter-status
    hidden
    class="text-sm text-center mt-4 leading-relaxed text-[var(--color-foreground)]"
  >
  </p>

  <p class="text-[0.7rem] text-[var(--color-muted-foreground)]/60 text-center mt-3 leading-relaxed">
    Double Opt-In. Keine Werbung Dritter. Abmeldung jederzeit über Link in jeder Mail.
    Zum Schutz vor Bots prüft Cloudflare Turnstile die Anmeldung (<a href="/datenschutz" class="underline underline-offset-2">Datenschutz</a>).
  </p>
</div>

<script>
  import { vorbereiten, holeToken, tokenVerbraucht, anmelden, HONEYPOT_FIELD, CONSENT_LABEL } from "../newsletter";

  document.querySelectorAll<HTMLFormElement>("[data-newsletter-form]").forEach((form) => {
    const status = form.parentElement?.querySelector<HTMLElement>("[data-newsletter-status]");
    const button = form.querySelector<HTMLButtonElement>("button[type='submit']");
    const platz = form.querySelector<HTMLElement>("[data-turnstile]")!;
    const minFill = Number(form.dataset.minFill ?? 0);
    const readyAt = Date.now();
    let running = false;

    // Turnstile erst laden, wenn jemand das Formular berührt.
    const starte = () => vorbereiten(platz);
    form.addEventListener("focusin", starte, { once: true });
    form.addEventListener("pointerdown", starte, { once: true });

    const zeige = (text: string) => { if (status) { status.textContent = text; status.hidden = false; } };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (running) return;
      running = true;
      if (button) button.disabled = true;

      const elapsed = Date.now() - readyAt;
      if (elapsed < minFill) await new Promise((r) => setTimeout(r, minFill - elapsed));

      const fd = new FormData(form);
      const token = await holeToken(platz);
      if (!token) {
        zeige("Die Sicherheitsprüfung konnte nicht geladen werden. Bitte die Seite neu laden und erneut versuchen.");
        running = false; if (button) button.disabled = false;
        return;
      }
      const r = await anmelden({
        email: String(fd.get("email") || ""), quelle: "formular", einwilligung: CONSENT_LABEL,
        t: readyAt, token, honigtopf: String(fd.get(HONEYPOT_FIELD) || ""),
      });
      tokenVerbraucht(platz);
      if (r.ok) {
        form.hidden = true;
        zeige("Fast geschafft. Bitte bestätige die Anmeldung über den Link in der E-Mail, die gleich bei dir ankommt.");
      } else {
        zeige(r.error || "Da ist etwas schiefgelaufen. Bitte versuch es gleich noch einmal.");
        running = false; if (button) button.disabled = false;
      }
    });
  });
</script>
