---
import {
  NEWSLETTER_ENDPOINT,
  EMAIL_FIELD,
  HONEYPOT_FIELD,
  CONSENT_FIELD,
  CONSENT_LABEL,
  TRAP_FIELD,
  MIN_FILL_MS,
} from "../newsletter";

interface Props {
  endpoint?: string;
  headline?: string;
}
const {
  endpoint = NEWSLETTER_ENDPOINT,
  headline = "Neue Werke, Ausstellungen, Texte — gelegentlich per Mail.",
} = Astro.props;
---

<div class="max-w-md mx-auto mt-10 mb-2">
  <div class="text-center mb-5">
    <div class="text-[0.65rem] tracking-[0.4em] uppercase text-[var(--color-accent)] mb-3">
      Newsletter
    </div>
    <p class="text-sm text-[var(--color-muted-foreground)] leading-relaxed">
      {headline}
    </p>
  </div>

  <form
    action={endpoint}
    method="post"
    class="flex flex-col gap-3"
    data-newsletter-form
    data-min-fill={MIN_FILL_MS}
  >
    <div class="flex flex-col sm:flex-row gap-2">
    <label class="sr-only" for="newsletter-email">E-Mail-Adresse</label>
    <input
      id="newsletter-email"
      type="email"
      name={EMAIL_FIELD}
      required
      autocomplete="email"
      placeholder="E-Mail-Adresse"
      class="flex-1 px-4 py-2.5 bg-[var(--color-card)] border border-[var(--color-border)] rounded-sm text-sm text-[var(--color-foreground)] placeholder:text-[var(--color-muted-foreground)]/50 focus:outline-none focus:border-[var(--color-accent)] focus:ring-1 focus:ring-[var(--color-accent)]/50 transition-colors"
    />
    {/* EmailOctopus-Honeypot — von Menschen unsichtbar, muss leer bleiben */}
    <div class="absolute left-[-5000px]" aria-hidden="true">
      <input
        type="text"
        name={HONEYPOT_FIELD}
        tabindex="-1"
        autocomplete="off"
      />
      {/* Eigener Honeypot: plausibler Feldname, den Formular-Bots gern ausfüllen.
          Wird nie mitgesendet — bei Inhalt bricht das Skript still ab. */}
      <input
        type="text"
        name={TRAP_FIELD}
        data-newsletter-trap
        tabindex="-1"
        autocomplete="off"
      />
    </div>
      <button
        type="submit"
        class="px-5 py-2.5 rounded-sm bg-[var(--color-accent)] text-[var(--color-accent-foreground)] text-xs tracking-[0.2em] uppercase font-medium glow-amber-sm hover:glow-amber transition-shadow whitespace-nowrap"
      >
        Abonnieren
      </button>
    </div>

    <label class="flex items-start gap-2.5 text-[0.7rem] text-[var(--color-muted-foreground)] leading-relaxed cursor-pointer">
      <input
        type="checkbox"
        name={CONSENT_FIELD}
        value="on"
        required
        class="mt-0.5 shrink-0 accent-[var(--color-accent)]"
      />
      <span>{CONSENT_LABEL}</span>
    </label>
  </form>

  <p
    data-newsletter-status
    hidden
    class="text-sm text-center mt-4 leading-relaxed text-[var(--color-foreground)]"
  >
  </p>

  <p class="text-[0.65rem] text-[var(--color-muted-foreground)]/60 text-center mt-3 leading-relaxed">
    Double Opt-In. Keine Werbung Dritter. Abmeldung jederzeit über Link in jeder Mail.
  </p>
</div>

<script>
  import { TRAP_FIELD } from "../newsletter";

  document.querySelectorAll<HTMLFormElement>("[data-newsletter-form]").forEach((form) => {
    const status = form.parentElement?.querySelector<HTMLElement>("[data-newsletter-status]");
    const button = form.querySelector<HTMLButtonElement>("button[type='submit']");
    const trap = form.querySelector<HTMLInputElement>("[data-newsletter-trap]");
    const minFill = Number(form.dataset.minFill ?? 0);
    const readyAt = Date.now();
    let running = false;

    const showSuccess = () => {
      form.hidden = true;
      if (status) {
        status.textContent =
          "Fast geschafft — bitte bestätige die Anmeldung über den Link in der E-Mail, die wir dir gerade geschickt haben.";
        status.hidden = false;
      }
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (running) return;
      running = true;

      // Honeypot gefüllt: Bot. Erfolg vortäuschen, nichts senden.
      if (trap?.value) {
        showSuccess();
        return;
      }

      if (button) button.disabled = true;

      // Zu schnell abgesendet: nicht ablehnen, nur bis zur Mindestzeit warten.
      const elapsed = Date.now() - readyAt;
      if (elapsed < minFill) {
        await new Promise((resolve) => setTimeout(resolve, minFill - elapsed));
      }

      // Nur die Felder senden, die EmailOctopus kennt — der eigene
      // Honeypot bleibt draußen.
      const payload = new URLSearchParams();
      new FormData(form).forEach((value, key) => {
        if (key !== TRAP_FIELD && typeof value === "string") payload.append(key, value);
      });

      try {
        const response = await fetch(form.action, {
          method: "POST",
          headers: { Accept: "application/json" },
          body: payload,
        });
        const data = await response.json().catch(() => ({}));

        if (response.ok && data?.success !== false) {
          showSuccess();
        } else {
          throw new Error(data?.error?.message ?? "Unbekannter Fehler");
        }
      } catch {
        running = false;
        if (button) button.disabled = false;
        if (status) {
          status.textContent =
            "Da ist etwas schiefgelaufen. Bitte versuch es gleich noch einmal.";
          status.hidden = false;
        }
      }
    });
  });
</script>
